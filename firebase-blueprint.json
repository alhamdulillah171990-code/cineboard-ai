{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A cinematic project containing input settings and generated output.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "userId", "input", "lastUpdated"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects collection."
    }
  }
}
